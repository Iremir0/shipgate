{
  "permissions": {
    "allow": [
      "Bash(git status *)", "Bash(git diff *)", "Bash(git log *)", "Bash(git branch *)", "Bash(git switch *)",
      "Bash(git add *)", "Bash(git commit *)", "Bash(git fetch *)", "Bash(git pull *)", "Bash(git merge *)",
      "Bash(git worktree *)", "Bash(git push *)",
      "Bash(gh *)", "Bash(env -u GITHUB_TOKEN gh *)",
      "Bash(npm ci)", "Bash(npm run *)", "Bash(npm test)", "Bash(npx tsx --test *)"
    ],
    "ask": [
      "Bash(npm install *)", "Bash(npm uninstall *)",
      "Bash(docker compose down*)"
    ],
    "deny": [
      "Read(.env)", "Read(.env.*)", "Read(./**/.env)", "Read(./**/secrets/**)",
      "Bash(git push --force*)", "Bash(git push -f*)", "Bash(git reset --hard*)",
      "Bash(npm audit fix --force*)",
      "Bash(docker compose down -v*)", "Bash(docker volume rm *)", "Bash(docker volume prune*)"
    ]
  }
}
